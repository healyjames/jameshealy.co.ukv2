---
interface Props {
  quote: string;
  author?: string;
}

const { quote, author } = Astro.props;
---

<figure class="not-prose my-6 md:mx-10">
  <blockquote>
    <p class="text-xl font-light text-base-content/80">{quote}</p>
  </blockquote>
  {author && <figcaption class="mt-2 pl-4 text-sm text-base-content/50">— {author}</figcaption>}
</figure>
