---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header>
  <div class="mx-10 md:flex md:justify-center md:items-center md:h-[90vh]">
    <h1
      class="font-semibold md:max-w-[700px] md:text-center text-7xl md:text-8xl m-1 xl:leading-tight leading-tight bg-gradient-to-r from-[#FA8BFF] via-[#2BD2FF] to-[#2BFF88] text-transparent bg-clip-text"
    >
      {title}
    </h1>
  </div>
</header>
