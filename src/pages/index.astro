---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import DesktopNavigation from '../components/navigation/DesktopNavigation.astro';
import MobileNavigation from '../components/navigation/MobileNavigation.astro';
import Header from '../components/Header.astro';
import Subheader from '../components/SubHeader.astro';
import Content from '../components/Content.astro';
import Timeline from '../components/timeline/Timeline.astro';
import TimelineItem from '../components/timeline/TimelineItem.astro';

import { ContentSquareContainer } from '../components/content-square/ContentSquareContainer';
import { ContentSquareItem } from '../components/content-square/ContentSquareItem';
import { Skills } from '../components/Skills';

import OutlinerImage from '../components/images/outliner.jpg';
import QuickcarsearchImage from '../components/images/quickcarsearch.jpg';
import ThgStatusImage from '../components/images/thg-status.jpg';
import JameshealyImage from '../components/images/james-healy-logo-gradient.jpg';
import RedcowV2Image from '../components/images/redcowv2.png';
import MaximumBookingsImage from '../components/images/maximum-bookings.png';

import { GlobeAltIcon } from '@heroicons/react/24/outline';
import { TrophyIcon } from '@heroicons/react/24/outline';
import { ArrowPathRoundedSquareIcon } from '@heroicons/react/24/solid';
import { CircleStackIcon } from '@heroicons/react/24/outline';
import { ArrowTrendingUpIcon } from '@heroicons/react/24/solid';
import { LightBulbIcon } from '@heroicons/react/24/outline';
---

<Layout title="Hey, I'm James!">
  <!-- Navigation -->
  <div class="block lg:hidden">
    <MobileNavigation />
  </div>
  <div class="hidden lg:block">
    <DesktopNavigation />
  </div>

  <!-- Content -->
  <main class="prose max-w-screen-lg my-10 mx-auto">
    <!-- Header / Intro Text -->
    <Header title="Senior Full Stack Software Engineer" />

    <Content id="about-me">
      <Subheader
        subtitle="~7 years of experience building high-quality scalable web applications and enabling teams to deliver at pace. Passionate about leveraging AI and agentic systems to improve both personal productivity and engineering workflows. Driven by the belief that faster delivery should never come at the expense of value, maintainability, or long-term quality, with a consistent focus on outcomes over output and solving meaningful business problems."
      />
    </Content>

    <div class="divider"></div>

    <!-- Skills list -->
    <Content>
      <Skills client:load />
    </Content>

    <div class="divider"></div>

    <!-- Work History -->
    <Timeline>
      <TimelineItem
        role="Senior Full Stack Engineer"
        time="2025 - present"
        company="Persimmon Homes PLC (FTSE 100)"
        location="Warrington, UK"
      >
        <ul>
          <li>
            Developed features within a <strong>composable architecture</strong>, enabling independent deployments, greater scalability and
            faster feature delivery.
          </li>
          <li>
            Built and maintained a <strong>Storybook component library</strong>, improving component reusability, documentation and design
            consistency across the platform.
          </li>
          <li>
            Leveraged <strong>AI agent workflows (Claude Code)</strong> to accelerate delivery, using specialist frontend, backend, testing and
            research agents to complete weeks of work in days.
          </li>

          <li>
            Maximised usage of our <strong>Headless CMS system</strong> to allow marketing teams to create content on the fly. Implemented data
            driven plot/development/scheme pages powered by upstream PIM system.
          </li>
          <li>
            Designed and implemented a <strong>custom static site generation pipeline</strong>, delivering a static-first architecture that
            significantly improved application performance.
          </li>
          <li>
            Collaborated with engineering leadership and change management to establish <strong>
              streamlined deployment governance and release processes</strong
            >.
          </li>
          <li>
            Built <strong>multi-environment GitHub Actions pipelines</strong>, reducing production deployments from hours to minutes and
            enabling multiple daily releases.
          </li>
        </ul>
      </TimelineItem>

      <TimelineItem role="Full Stack Engineer" time="2021 - 2025" company="THG" location="Manchester, UK">
        <ul>
          <li>
            Worked across three engineering teams, gaining end-to-end experience spanning <strong>
              cloud infrastructure, backend services and frontend e-commerce development
            </strong>.
          </li>
          <li>
            Delivered <strong>complex third-party integrations</strong>, including PowerReviews and Obsess VR, enhancing the e-commerce
            experience for enterprise clients.
          </li>
          <li>
            Helped deliver the <strong>migration of Homebase's e-commerce platform</strong> to a modern Node.js/TypeScript architecture, rebuilding
            core features including Click &amp; Collect and Store Locator.
          </li>
          <li>
            Migrated applications from dedicated <strong>virtual machines to the company's Kubernetes platform</strong>, improving
            scalability and operational efficiency.
          </li>
          <li>
            Configured Kubernetes-based<strong>GitHub Actions Runner Controller (ARC) runners</strong> to support the team's CI/CD workflows.
          </li>
          <li>
            Onboarded major UK and international brands onto their latest TypeScript/NextJS ecommerce retail platform including <strong
              >Homebase, Heinz, Lyle &amp; Scott, Matalan, White Stuff</strong
            > and more.
          </li>
          <li>
            Developed and maintained <strong>backend services in Java and Python</strong>, supporting business-critical e-commerce
            applications.
          </li>
        </ul>

        <TimelineItem
          role="Digital & Technology Solutions Apprentice"
          time="2015 - 2021"
          company="The Travel Visa Company"
          location="Crewe, UK"
        >
          <ul>
            <li>
              Progressed from social media and graphic design into web development over six years, building WordPress sites and UI
              components informed by design principles and brand guidelines.
            </li>
            <li>
              Built a PDF visa application pack generator with a dashboard UI, and redesigned a visa requirement widget that boosted user
              engagement - all while completing a first-class Digital &amp; Technology Solutions degree (Software Engineering pathway).
            </li>
          </ul>
        </TimelineItem>

        <TimelineItem role="Kitchen Assistant" time="2014 - 2015" company="Gees Kitchen" location="Sandbach, UK">
          <ul>
            <li>Pot washing, general prep work and kitchen hygiene. Humble beginnings.</li>
          </ul>
        </TimelineItem>
      </TimelineItem>

      <div class="divider"></div>

      <!-- Personal Projects -->
      <Content id="personal-projects">
        <h2>Personal Projects</h2>
        <Card
          title="Maximum Bookings"
          buttonText="Preview"
          href="https://redcownantwich.co.uk/reservations/"
          image={MaximumBookingsImage}
          imageAltText="Screenshot of redcownantwich.co.uk homepage"
        >
          <p>
            Multi-tenant restaurant reservation system built on Cloudflare Workers. A single deployment serves a Preact frontend and Hono
            REST API, backed by Cloudflare D1 (edge SQLite) database. The project was built end-to-end with Claude via a custom Squad agent
            framework - a team of named AI specialists with defined roles, living inside the repo with shared docs as persistent memory.
            Business rules, capacity logic, and data models live as markdown files that serve as the single source of truth for both the
            implementation and the AI team's persistent memory across sessions.
          </p>
        </Card>

        <Card
          title="RedcowV2"
          buttonText="Visit the site"
          href="http://redcownantwich.co.uk/"
          image={RedcowV2Image}
          imageAltText="Screenshot of redcownantwich.co.uk homepage"
          reverse={true}
        >
          <p>
            Content focused custom whitelabel platform tailored towards small local pubs, restaurants and cafes aiming to provide an
            incredibly performant site to rank highly in search engines. Built using AstroJS and plain vanilla CSS with a focus on
            accessibility and SEO. No CMS, branded data is simply stored in a structured .ts file and compiled during build time for pure
            simplicity and ease.
          </p>
        </Card>

        <Card
          title="Quickcarsearch.io"
          buttonText="View project on GitHub"
          href="https://github.com/healyjames/quickcarsearch-next"
          image={QuickcarsearchImage}
          imageAltText="Laptop screen showing quickcarsearch.io homepage"
        >
          <p>
            NextJS and Styled Components web application for finding the cheapest car based on your budget. I created with the aim of being
            extremely performant, user friendly, SEO friendly and accessible - the site achieved <a
              href="/images/quickcarsearch-lighthouse.jpg">a score of 100 for every lighthouse metric</a
            >. Dockerised and deployed using AWS Amplify.
          </p>
        </Card>

        <Card
          title="THG Status"
          image={ThgStatusImage}
          imageAltText="Laptop screen showing internal tooling dashboard tracking health of applications"
          reverse={true}
        >
          <p>
            Internal healthcheck tool using a NextJS 13 &amp; Tailwind UI, ExpressJS API and MSSQL database. A CRON GitHub pipeline ran
            every 3 minutes to fetch http status codes which the API would serve as JSON. The UIs job was purely to display the data and
            allow users to keep track of endpoints that were important to them. The API did a lot of the heavy lifting e.g. interacting with
            the database and generating the json data for the UI to consume.
          </p>
        </Card>

        <Card
          title="Outliner"
          image={OutlinerImage}
          imageAltText="Google chrome extensions page with dea+tails of Outliner extension on screen"
          buttonText="View on Chrome Web Store"
          href="https://chromewebstore.google.com/detail/outliner/nkihollbkhfekaoobfmoigabmbjppfko?hl=en&authuser=0"
        >
          <p>
            Chrome extension that visually highlights the various different widgets on a THG site and displays important information each
            widget such as the type and ID number.
          </p>
        </Card>

        <Card
          title="Jameshealy.co.uk"
          image={JameshealyImage}
          imageAltText="jameshealy.co.uk logo"
          reverse={true}
          buttonText="View on GitHub"
          href="https://github.com/healyjames/jameshealy.co.ukv2"
        >
          <p>
            I built jameshealy.co.uk as a project to modernize my old portfolio and experiment with the latest technologies. The site has
            been built using Astro JS and styled with Tailwind / Daisy UI. I'm excited to see how these tools can be used to create even
            more impressive projects in the future.
          </p>
        </Card>
      </Content>

      <div class="divider"></div>

      <!-- Achievements  -->
      <Content id="achievements">
        <h2>Achievements</h2>
        <ContentSquareContainer client:load>
          <ContentSquareItem
            icon={GlobeAltIcon}
            title="Homebase"
            content="I played a crucial role in the development and migration of <a class='text-[#F4D03F]' href='https://www.homebase.co.uk'>homebase.co.uk</a> to THG's latest e-commerce solution where I was able to refine my skills with NextJS and GraphQL."
            extended={{ vertical: true }}
            className="lg:col-span-1 lg:row-span-2 bg-gradient-to-tl from-[#F4D03F] to-[#16A085] text-white lg:self-center"
          />
          <ContentSquareItem
            icon={TrophyIcon}
            title="Awards"
            content="Winner of Apprentice Of The Year for South Cheshire and runner up for Future Leader"
            className="bg-primary text-primary-content lg:self-end"
          />
          <ContentSquareItem
            icon={ArrowPathRoundedSquareIcon}
            title="CI/CD & K8s"
            content="Setting up GitHub ARC runners, K8s deployment/rollback pipelines, and migrating legacy apps to Kubernetes"
            className="bg-secondary text-secondary-content lg:self-end"
          />
          <ContentSquareItem
            icon={CircleStackIcon}
            title="Full Stack"
            content="Spent time proffessionaly working on front-end, back-end and devops technologies."
            className="bg-accent text-accent-content lg:self-end"
          />
          <ContentSquareItem
            icon={LightBulbIcon}
            title="Outliner"
            content="Chrome extension to provide visual information for widgets on a given THG site."
            className="border-8 border-base-content text-base-content lg:self-start"
          />
          <ContentSquareItem
            icon={ArrowTrendingUpIcon}
            title="THG Status"
            content="Personal development project: Internal healtcheck tool built to track http status for a given service and display in user friendly UI."
            extended={{ horizontal: true }}
            className="lg:col-span-2 bg-gradient-to-l from-[#FF3CAC] via-[#784BA0] to-[#2B86C5] text-white lg:self-start"
          />
        </ContentSquareContainer>
      </Content>

      <div class="divider"></div>

      <!-- Mentions  -->
      <Content id="mentions">
        <div class="flex gap-2 flex-wrap justify-center items-center">
          <a class="btn" href="https://astro.build/">Astro</a>
          <a class="btn" href="https://tailwindcss.com/">Tailwind</a>
          <a class="btn" href="https://react.dev/">React</a>
          <a class="btn" href="https://daisyui.com/">DaisyUI</a>
          <a class="btn" href="https://heroicons.com/">HeroIcons</a>
          <a class="btn" href="https://www.grabient.com/">Grabient</a>
        </div>
      </Content>

      <div class="divider"></div>

      <!-- Get in touch -->
      <Content>
        <p class="text-center">
          Feel free to add me on <a
            href="https://www.linkedin.com/in/healyjames97/"
            class="badge bg-[#0a66c2] text-white underline-offset-8">LinkedIn</a
          > and we can chat!
        </p>
      </Content>
    </Timeline>
  </main>
</Layout>
